# Gridlock FastAPI Backend Settings

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Set USE_LOCAL_DB to true to use the local SQLite fallback database (gridlock_local.db)
# Set to false to force using Supabase
USE_LOCAL_DB=true

# Supabase Credentials (Required if USE_LOCAL_DB=false)
# Copy these from your Supabase Project Settings -> API
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_role_key
